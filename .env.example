# AI incident narrative — set ONE of the keys below (whichever provider you
# already have). dfirauto auto-detects which one is present. If more than one
# is set, priority is: ANTHROPIC_API_KEY > GEMINI_API_KEY > OPENAI_API_KEY.
# Without any of them, dfirauto still runs and produces full triage results;
# it just skips the AI narrative/recommendations section (fails gracefully,
# no crash).

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini (free tier) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
